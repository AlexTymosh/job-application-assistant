# Public fake profile committed to this repository.
PROFILE_NAME=example
PROFILE_DATA_DIR=profiles/example

# Recommended for real private usage:
# Keep real profile data outside the git repository.
# Example on Windows:
# PROFILE_NAME=alex
# PROFILE_DATA_DIR=C:/Users/YOUR_USER/job-application-assistant-data/alex

# Use fake extraction by default for a release-safe local demo.
# Set LLM_EXTRACTION_MODE=openai only when OPENAI_API_KEY and models are configured.
LLM_EXTRACTION_MODE=fake

# OpenAI credentials and model names are optional for local tests.
# Never commit a real API key. Tests must not require OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACT=
OPENAI_MODEL_TAILOR=
OPENAI_MODEL_QA=
